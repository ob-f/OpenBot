<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".cartfollow.HumanCartSimulatorFragment">

    <org.openbot.customview.OverlayView
        android:id="@+id/tracking_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/command_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="12dp"
        android:background="#80000000"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/cart_sim_idle"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/steering_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="36dp"
        android:background="#A6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/command_text">

        <TextView
            android:id="@+id/steering_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            tools:text="转向需求 72% · 向右大幅转弯\n当前 +0.48 · 预测 +0.66（提前 400 ms）" />

        <org.openbot.customview.SteeringDemandView
            android:id="@+id/steering_gauge"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:contentDescription="转向需求仪表" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/prediction_horizon_group"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prediction_0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="预测 0 ms"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prediction_400"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="预测 400 ms"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prediction_800"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:text="预测 800 ms"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/simulator_experiment_scroll"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@id/confirm_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/steering_panel">

    <LinearLayout
        android:id="@+id/simulator_experiment_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A6000000"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/real_experiment_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/auto_gear_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auto_gear_14"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="40dp" android:text="最高 c14" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auto_gear_18"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="40dp" android:text="最高 c18" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/auto_gear_21"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="40dp" android:text="最高 c21" android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/real_search_enabled"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="本次允许主动旋转搜索" android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/gallery_mode_group"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery_static"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:text="固定 Gallery"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gallery_adaptive"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:text="动态 Gallery"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/recent_gallery_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="近期记忆"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/recovery_timeout_group"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_2s"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:text="普通重捕 2s"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_5s"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minHeight="0dp"
                    android:text="普通重捕 5s"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/directed_search_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/search_speed_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="模拟旋转档位 c18"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/search_speed_slider"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:contentDescription="模拟旋转档位"
                android:stepSize="1"
                android:value="18"
                android:valueFrom="5"
                android:valueTo="21" />

            <TextView
                android:id="@+id/search_angle_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="最大搜索角度 90°"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/search_angle_slider"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:contentDescription="最大搜索角度"
                android:stepSize="15"
                android:value="90"
                android:valueFrom="30"
                android:valueTo="180" />

            <TextView
                android:id="@+id/search_timeout_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="最大搜索时间 5.0 秒"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/search_timeout_slider"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:contentDescription="最大搜索时间"
                android:stepSize="0.5"
                android:value="5"
                android:valueFrom="1"
                android:valueTo="10" />
        </LinearLayout>

        <TextView
            android:id="@+id/gyro_test_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="独立转角测试=待命 0°/90°"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gyro_test_left"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="独立陀螺仪向左测试"
                android:tooltipText="向左测试"
                android:text="↶" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gyro_test_right"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="独立陀螺仪向右测试"
                android:tooltipText="向右测试"
                android:text="↷" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gyro_test_stop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="停止独立陀螺仪测试"
                android:tooltipText="停止测试"
                android:text="■" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gyro_test_reset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                android:contentDescription="复位独立陀螺仪测试"
                android:tooltipText="复位测试"
                android:text="↺" />
        </LinearLayout>

        <TextView
            android:id="@+id/simulator_frame_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待相机帧"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/simulator_reconfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重新采集并确认目标"
            android:visibility="gone" />

        <TextView
            android:id="@+id/simulator_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="流程=待命 | 身份=未确认 | Gallery=0+0\n距离=- | 模拟停车 c0,0"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/debug_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="#80000000"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/debug_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            tools:text="fps=0.0\nstate=IDLE\naction=-\npersons=0" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_debug_details"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="调试详情"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_test_records"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="测试记录"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_target_event"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="目标离开画面"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="#CC000000"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/confirm_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/confirm_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/real_control_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/snapshot_view"
            android:layout_width="96dp"
            android:layout_height="128dp"
            android:background="#33000000"
            android:contentDescription="@string/cart_simulator"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="是否跟随此人？"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="确认" />

                <Button
                    android:id="@+id/btn_retake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="重拍" />

                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="取消" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/real_control_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottom_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/real_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLE 未连接"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/real_mode_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/real_mode_manual"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="手动" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/real_mode_auto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="自动实验" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/manual_drive_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:splitMotionEvents="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/drive_left"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="↶"
                android:textSize="22sp" />

            <Button
                android:id="@+id/drive_forward"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="↑"
                android:textSize="22sp" />

            <Button
                android:id="@+id/drive_backward"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="↓"
                android:textSize="22sp" />

            <Button
                android:id="@+id/drive_right"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="↷"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/manual_speed_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/manual_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="手动直行速度：前进 c14（约 160 mm/s） · 后退 c-12（约 137 mm/s）"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/manual_speed_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="手动直行速度"
                android:stepSize="1"
                android:value="14"
                android:valueFrom="9"
                android:valueTo="21" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/connect_ble"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="连接 BLE" />

            <Button
                android:id="@+id/unlock_auto"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="长按解锁自动"
                android:visibility="gone" />

            <Button
                android:id="@+id/emergency_stop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#D32F2F"
                android:text="急停"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/real_safety_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="近场传感器未接入，仅限空旷实验"
            android:textColor="#FFFF8A80"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/steering_strength_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/steering_strength_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="转弯强度 100% · 最大差速 10,14"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/steering_strength_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="100"
                android:stepSize="5"
                android:valueFrom="20"
                android:valueTo="200" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/steering_tuning_note"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:hint="本轮备注（可选）"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textColorHint="#BDBDBD"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/record_steering_tuning"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="记录参数"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:paddingVertical="12dp"
                android:paddingStart="8dp"
                android:text="@string/model"
                android:textColor="@android:color/white" />

            <Spinner
                android:id="@+id/model_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:prompt="@string/model" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:paddingStart="8dp"
                android:text="@string/confidence"
                android:textColor="@android:color/white" />

            <ImageView
                android:id="@+id/minus_confidence"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.3"
                android:contentDescription="@string/minus"
                android:src="@drawable/ic_baseline_remove" />

            <TextView
                android:id="@+id/confidence_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:gravity="center"
                android:padding="4dp"
                android:text="50%"
                android:textColor="@android:color/white" />

            <ImageView
                android:id="@+id/plus_confidence"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.3"
                android:contentDescription="@string/plus"
                android:src="@drawable/ic_baseline_add" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/diagnostic_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:checked="false"
                android:text="记录日志"
                android:textColor="@android:color/white" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/start_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:text="@string/cart_sim_start"
                android:textColor="@android:color/white" />
        </LinearLayout>
        <TextView
            android:id="@+id/diagnostic_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="日志关闭"
            android:textSize="11sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
