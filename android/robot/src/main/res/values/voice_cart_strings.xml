<resources>
    <string name="voice_cart_title">Voice Cart Simulator</string>
    <string name="voice_cart_welcome">你好，欢迎使用语音购物车模拟器。打开开始开关后，我会引导你完成初始化。</string>
    <string name="voice_cart_capture">请走到镜头前，画面中只保留你一个人，并保持站立。</string>
